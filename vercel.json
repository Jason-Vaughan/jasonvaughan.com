{
  "rewrites": [
    {
      "source": "/openai.2",
      "destination": "/openai.2/index.html"
    },
    {
      "source": "/openai",
      "destination": "/openai/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{content/embeddings.json,public/git-stats.json}"
    }
  }
}